  <SolidColorBrush x:Key="Ink3Brush" Color="#838B96" />
  <SolidColorBrush x:Key="DisabledInkBrush" Color="#9199A4" />
  <SolidColorBrush x:Key="GlyphBrush" Color="#B4BAC3" />
