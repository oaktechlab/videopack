<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Palette: neutral light surfaces, blue reserved for action, selection and progress. -->
  <SolidColorBrush x:Key="AccentBrush" Color="#0B6BDA" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A5FC4" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#094FA6" />
