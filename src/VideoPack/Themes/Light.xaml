  <SolidColorBrush x:Key="LockVeilBrush" Color="#B3F5F6F8" />
  <SolidColorBrush x:Key="DropVeilBrush" Color="#F0F7FAFE" />
  <SolidColorBrush x:Key="ModalVeilBrush" Color="#7316191D" />

  <Visibility x:Key="LightOnlyVisibility">Visible</Visibility>
  <Visibility x:Key="DarkOnlyVisibility">Collapsed</Visibility>
  <sys:String x:Key="ThemeToggleGlyph">&#xE708;</sys:String>
  <sys:String x:Key="ThemeToggleLabel">Modo oscuro</sys:String>
</ResourceDictionary>
